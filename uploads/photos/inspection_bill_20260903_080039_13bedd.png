@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&family=Roboto:wght@400;500;700&family=JetBrains+Mono:wght@500;600;700&display=swap');

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 13.5px;
  line-height: 1.45;
  color: #334155;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.font-heading {
  font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
}

.font-mono {
  font-family: 'JetBrains Mono', monospace;
}

.pb-safe {
  padding-bottom: calc(env(safe-area-inset-bottom, 1rem) + 4.5rem);
}

.pt-safe {
  padding-top: env(safe-area-inset-top, 0.5rem);
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}

.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

[x-cloak] {
  display: none !important;
}

.touch-press {
  transition: transform 0.12s ease, background-color 0.12s ease, border-color 0.12s ease;
}

.touch-press:active {
  transform: scale(0.98);
}

/* Custom scrollbars for desktop viewports */
@media (min-width: 768px) {
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.3);
    border-radius: 9999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: rgba(148, 163, 184, 0.6);
  }
}
