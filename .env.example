# =========================================================================
# Software CRM — Environment Configuration
# =========================================================================
# Copy this file to .env and configure your transactional email service.

# Application Environment: 'production' or 'development'
APP_ENV=development

# Database Settings (Defaults to Hostinger / Localhost MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u213657911_crm
DB_USER=u213657911_crm
DB_PASS=Sarekam@1234

# =========================================================================
# TRANSACTIONAL EMAIL PROVIDERS (Choose one or use 'auto')
# =========================================================================
# 'auto' automatically tries providers in order: Resend -> Brevo -> SMTP -> AppsScript
EMAIL_PROVIDER=auto

# Sender identity
SMTP_FROM=security@softwarecrm.com
SMTP_FROM_NAME="Software CRM Security"

# 1. Resend API (Recommended - https://resend.com)
# Free tier: 100 emails/day, instant delivery
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# 2. Brevo / Sendinblue API (https://brevo.com)
# Free tier: 300 emails/day, no credit card required
BREVO_API_KEY=
BREVO_SENDER_EMAIL=security@softwarecrm.com
BREVO_SENDER_NAME="Software CRM Security"

# 3. Authenticated Direct SMTP (Gmail App Password, Brevo SMTP, Amazon SES, Hostinger)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# 4. Google Apps Script Web App Forwarder
APPS_SCRIPT_OTP_URL=https://script.google.com/macros/s/AKfycbzzWyj66mDMP__bUzfSYqjAgY5Dif_OcXIvq-XMAE4_X-XODxv_0Is4HVy7rr3sP4MRHw/exec

# =========================================================================
# Google OAuth 2.0 Sign-In Credentials
# =========================================================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google_callback.php
GOOGLE_WORKSPACE_DOMAIN=
